{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/:rest*",
        "destination": "/:rest*",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
