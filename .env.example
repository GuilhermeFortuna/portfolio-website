# Copy to .env.local (gitignored) and fill in real values.

# Aegis admin credentials for the local screenshot automation
# (scripts/playwright). Read only by scripts/playwright/aegis/login.ts.
# Never used for anything other than a local Aegis demo/dev stack.
SCREENSHOT_EMAIL=admin@example.com
SCREENSHOT_PASSWORD=

# Optional overrides for where the three external project repositories live
# on disk. If unset, scripts/playwright/engine/repo-paths.ts falls back to
# the sibling-directory convention: ../aegis-project, ../q, ../nexo relative
# to this repo.
# SCREENSHOTS_AEGIS_PATH=/path/to/aegis-project
# SCREENSHOTS_Q_PATH=/path/to/q
# SCREENSHOTS_NEXO_PATH=/path/to/nexo
