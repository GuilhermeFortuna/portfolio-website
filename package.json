{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci:local": "bash scripts/ci.sh",
    "screenshots:q": "tsx scripts/playwright/engine/capture.ts --project=q",
    "screenshots:aegis": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/playwright/engine/capture.ts --project=aegis",
    "screenshots:nexo": "tsx scripts/playwright/engine/capture.ts --project=nexo",
    "screenshots:all": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/playwright/engine/capture.ts --project=all",
    "screenshots:auth:aegis": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/playwright/engine/capture.ts --project=aegis --auth-only",
    "screenshots:auth:nexo": "tsx scripts/playwright/engine/capture.ts --project=nexo --auth-only",
    "screenshots:promote:q": "tsx scripts/playwright/engine/promote.ts --project=q",
    "screenshots:promote:aegis": "tsx scripts/playwright/engine/promote.ts --project=aegis",
    "screenshots:promote:nexo": "tsx scripts/playwright/engine/promote.ts --project=nexo"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.78",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "@tsparticles/slim": "^4.3.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "1.3.25",
    "motion": "12.43.0",
    "next": "16.2.12",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.25.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
